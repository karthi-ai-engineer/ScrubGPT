# ── Secrets ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Data: videos, case packages, caches (synced via Google Drive, NEVER git) ──
data/*
!data/README.md

# Media files anywhere in the repo are ignored...
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.wav
*.mp3
*.m4a
*.opus
*.flac
# ...except small SYNTHETIC fixture media (no real surgical video; < 5 MB total)
!contracts/fixtures/**/*.mp4
!contracts/fixtures/**/*.webm
!contracts/fixtures/**/*.wav

# ── Python ──────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / web ──────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Local databases & logs ──────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.log
logs/

# ── Editors / OS ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ── Claude Code (personal settings stay local) ──────────
.claude/settings.local.json
