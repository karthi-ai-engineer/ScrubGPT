# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env` or paste keys into chat.

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=
# Model tiers (see docs/MVP_Master_Plan.md §3.1). Exact model names to be confirmed.
VISION_FAST_MODEL=
VISION_DEEP_MODEL=
TEXT_SMART_MODEL=
TEXT_FAST_MODEL=
STT_MODEL=whisper-1
STT_DIARIZE_MODEL=gpt-4o-transcribe-diarize
TTS_MODEL=
EMBED_MODEL=

# ── Data (Google Drive-synced folder; see data/README.md) ──
DATA_DIR=./data

# ── Brain API (Dev1) ───────────────────────────────────
BRAIN_PORT=8100
# Cache: readwrite (normal) | readonly (offline demo: cached responses only) | off
CACHE_MODE=readwrite

# ── App server (Dev2) ──────────────────────────────────
APP_PORT=8000
# Local SQLite file. Keep it OUT of the Google Drive folder (sync can corrupt a live DB).
APP_DB_PATH=./app/server/.local/scrubgpt.sqlite
# Brain client: mock (contracts/mock_brain fixtures) | real (Brain API)
BRAIN_MODE=mock
BRAIN_URL=http://localhost:8100
