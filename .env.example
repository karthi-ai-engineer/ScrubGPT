# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env` or paste keys into chat.

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=
# Model tiers (see docs/MVP_Master_Plan.md §3.1). Exact model names to be confirmed.
VISION_FAST_MODEL=
VISION_DEEP_MODEL=
TEXT_SMART_MODEL=
TEXT_FAST_MODEL=
STT_MODEL=whisper-1
STT_DIARIZE_MODEL=gpt-4o-transcribe-diarize
TTS_MODEL=
EMBED_MODEL=

# Relative paths below resolve against the REPO ROOT (D-034).

# ── Data (see data/README.md) ──────────────────────────
# Dev1: the Google Drive folder, e.g. G:/My Drive/ScrubGPT-data
# Dev2: ./contracts/fixtures until integration (Friday drops are validated by path)
DATA_DIR=./contracts/fixtures

# ── Brain API (Dev1) ───────────────────────────────────
BRAIN_PORT=8100
# Cache: readwrite (normal) | readonly (offline demo: cached responses only) | off
CACHE_MODE=readwrite

# ── App server (Dev2) ──────────────────────────────────
APP_PORT=8000
# Local SQLite file, relative to the repo root. Keep it OUT of the Google Drive folder (sync can corrupt a live DB).
APP_DB_PATH=./app/server/.local/scrubgpt.sqlite
# Brain client: mock (fake Brain, :8101) | real (Brain API, :8100)
BRAIN_MODE=mock
MOCK_BRAIN_URL=http://localhost:8101
BRAIN_URL=http://localhost:8100
