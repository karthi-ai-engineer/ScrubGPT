{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Bilingual": {
      "description": "Human-readable text in Japanese and English. Both halves are non-empty.",
      "properties": {
        "ja": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "ja",
        "en"
      ],
      "title": "Bilingual",
      "type": "object"
    },
    "FlagReason": {
      "description": "One signal behind a flagged moment.",
      "properties": {
        "signal": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/Bilingual"
        }
      },
      "required": [
        "signal",
        "detail"
      ],
      "title": "FlagReason",
      "type": "object"
    },
    "GeneratedBy": {
      "description": "The model and prompt that produced an AI output.",
      "properties": {
        "model_tier": {
          "description": "The `.env` tier, e.g. `VISION_FAST` or `TEXT_SMART` (plan §3.1).",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "model": {
          "description": "The concrete model name the tier resolved to.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The prompt file and version, e.g. `step_window.v1`; `null` when no prompt was used."
        }
      },
      "required": [
        "model_tier",
        "model",
        "prompt_version"
      ],
      "title": "GeneratedBy",
      "type": "object"
    },
    "Moment": {
      "description": "A flagged moment worth asking the surgeon about.",
      "properties": {
        "t_start": {
          "description": "Seconds from the start of the normalised video.",
          "minimum": 0.0,
          "type": "number"
        },
        "t_end": {
          "description": "Seconds from the start of the normalised video; never before `t_start`.",
          "minimum": 0.0,
          "type": "number"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.m[0-9]{2,}$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MomentKind"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]*\\.p[0-9]{2,}\\.s[0-9]{2,}$",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Bilingual"
        },
        "why_flagged": {
          "items": {
            "$ref": "#/$defs/FlagReason"
          },
          "type": "array"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "clip": {
          "description": "Always `clips/<moment_id>.mp4`.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "poster": {
          "description": "Always `clips/<moment_id>.jpg`.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "deep_look": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ],
          "description": "The VISION_DEEP description (C6), if it was run."
        },
        "draft_obstacle": {
          "anyOf": [
            {
              "pattern": "^(?:bleeding|anatomical_variation|tissue_condition|visibility|technical_difficulty|equipment|patient_condition|unexpected_finding)\\.[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.p[0-9]{2,}\\.s[0-9]{2,}\\.c[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set exactly when `kind` is `checkpoint`; a checkpoint of `step_id`."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "t_start",
        "t_end",
        "id",
        "kind",
        "step_id",
        "title",
        "why_flagged",
        "score",
        "clip",
        "poster",
        "deep_look",
        "draft_obstacle",
        "checkpoint_id",
        "provenance"
      ],
      "title": "Moment",
      "type": "object"
    },
    "MomentKind": {
      "description": "Why the moment was flagged (E1–E5).",
      "enum": [
        "deviation",
        "event",
        "speech",
        "checkpoint"
      ],
      "title": "MomentKind",
      "type": "string"
    },
    "Provenance": {
      "description": "Where a piece of knowledge came from, and who confirmed it.",
      "properties": {
        "trust_label": {
          "$ref": "#/$defs/TrustLabel"
        },
        "attributed_to": {
          "$ref": "#/$defs/Role"
        },
        "generated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedBy"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` unless an AI model produced it."
        },
        "confirmed_by": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "trust_label",
        "attributed_to",
        "generated_by",
        "confirmed_by",
        "confirmed_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Role": {
      "description": "Who a piece of knowledge is attributed to.",
      "enum": [
        "ai",
        "dataset",
        "narrator",
        "operating_surgeon",
        "reviewer",
        "expert",
        "dev_team_simulated"
      ],
      "title": "Role",
      "type": "string"
    },
    "TrustLabel": {
      "description": "How far a piece of knowledge can be trusted. The emoji are for display only.",
      "enum": [
        "ai_detected",
        "dataset_annotation",
        "narration_extracted",
        "operating_surgeon",
        "reviewer",
        "expert_validated",
        "simulated"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "description": "`moments.json`: the flagged moments, ranked (list order = rank).",
  "properties": {
    "contract_version": {
      "description": "`\"MAJOR.MINOR\"`, currently `\"1.0\"`.",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "moments": {
      "items": {
        "$ref": "#/$defs/Moment"
      },
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "case_id",
    "moments"
  ],
  "title": "Moments",
  "type": "object"
}
