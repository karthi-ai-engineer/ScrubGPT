{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Bilingual": {
      "description": "Human-readable text in Japanese and English. Both halves are non-empty.",
      "properties": {
        "ja": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "ja",
        "en"
      ],
      "title": "Bilingual",
      "type": "object"
    },
    "BriefingSection": {
      "description": "One section of a briefing.",
      "properties": {
        "title": {
          "$ref": "#/$defs/Bilingual"
        },
        "body": {
          "$ref": "#/$defs/Bilingual"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "body",
        "citations"
      ],
      "title": "BriefingSection",
      "type": "object"
    },
    "Citation": {
      "description": "A record an answer is based on, and optionally one of its evidence items.",
      "properties": {
        "record_id": {
          "description": "One of the candidate records sent in the request.",
          "format": "uuid7",
          "type": "string"
        },
        "evidence_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "An index into that record's `evidence[]` (e.g. the clip to play); `null` for the whole\nrecord."
        }
      },
      "required": [
        "record_id",
        "evidence_index"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "description": "The briefing, section by section.",
  "properties": {
    "contract_version": {
      "description": "`\"MAJOR.MINOR\"`, currently `\"1.0\"`.",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/BriefingSection"
      },
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "sections"
  ],
  "title": "BriefingResponse",
  "type": "object"
}
