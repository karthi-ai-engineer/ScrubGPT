{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActionType": {
      "description": "Whether the surgeon acted, or deliberately chose not to act.",
      "enum": [
        "act",
        "deliberate_non_action"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Actor": {
      "description": "Who carried out the action.",
      "enum": [
        "surgeon",
        "assistant",
        "resident",
        "bedside",
        "anesthesia",
        "unknown"
      ],
      "title": "Actor",
      "type": "string"
    },
    "Alternative": {
      "description": "An option the surgeon considered, and why it wasn't chosen.",
      "properties": {
        "option": {
          "$ref": "#/$defs/Bilingual"
        },
        "why_not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "option",
        "why_not"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AnswerAudioEvidence": {
      "description": "The recording of a surgeon's spoken answer.",
      "properties": {
        "kind": {
          "const": "answer_audio",
          "type": "string"
        },
        "answer_id": {
          "format": "uuid7",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "answer_id",
        "uri"
      ],
      "title": "AnswerAudioEvidence",
      "type": "object"
    },
    "AnswerTextEvidence": {
      "description": "A verbatim quote from a surgeon's answer (typed, or transcribed from voice).",
      "properties": {
        "kind": {
          "const": "answer_text",
          "type": "string"
        },
        "answer_id": {
          "format": "uuid7",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "quote": {
          "description": "Verbatim, in the original language.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "answer_id",
        "quote"
      ],
      "title": "AnswerTextEvidence",
      "type": "object"
    },
    "Bilingual": {
      "description": "Human-readable text in Japanese and English. Both halves are non-empty.",
      "properties": {
        "ja": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "ja",
        "en"
      ],
      "title": "Bilingual",
      "type": "object"
    },
    "Chip": {
      "description": "One extracted field, shown to the surgeon to confirm or edit.",
      "properties": {
        "field": {
          "description": "The draft field it shows, e.g. `reason` or `alternatives[0].why_not`.",
          "pattern": "^[a-z_][a-z0-9_]*(?:\\[[0-9]+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[[0-9]+\\])*)*$",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ],
          "description": "The field's value in the draft; `null` only for a field the surgeon must still fill\n(`situation_cue.text` or `action.text`, listed in `missing_fields`, D-054)."
        },
        "editable": {
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "value",
        "editable"
      ],
      "title": "Chip",
      "type": "object"
    },
    "DecisionRecordDraft": {
      "description": "What `/v1/answers/extract` returns: `id` and the confirmation fields are null.\n\nUnlike a `DecisionRecord`, `situation_cue.text` and `action.text` may be null: the surgeon\ndidn't state them. `/extract` then lists them in `missing_fields[]` with an editable chip, and\nthe draft can't be confirmed until the surgeon fills them (D-054).",
      "properties": {
        "contract_version": {
          "description": "`\"MAJOR.MINOR\"`, currently `\"1.0\"`.",
          "pattern": "^1\\.(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "id": {
          "type": "null"
        },
        "case_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "moment_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.m[0-9]{2,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` for a record that isn't tied to one flagged moment."
        },
        "step_id": {
          "description": "A step of the Procedure Reference.",
          "pattern": "^[a-z][a-z0-9_]*\\.p[0-9]{2,}\\.s[0-9]{2,}$",
          "type": "string"
        },
        "language": {
          "allOf": [
            {
              "$ref": "#/$defs/Lang"
            }
          ],
          "description": "The language the answer was originally given in."
        },
        "kind": {
          "$ref": "#/$defs/RecordKind"
        },
        "context": {
          "$ref": "#/$defs/RecordContext"
        },
        "situation_cue": {
          "$ref": "#/$defs/DraftSituationCue"
        },
        "obstacle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Obstacle"
            },
            {
              "type": "null"
            }
          ]
        },
        "anticipation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the surgeon expected or planned."
        },
        "action": {
          "$ref": "#/$defs/DraftAction"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        },
        "immediate_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        },
        "delayed_outcome": {
          "$ref": "#/$defs/DelayedOutcome"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "answer_audio": "#/$defs/AnswerAudioEvidence",
                "answer_text": "#/$defs/AnswerTextEvidence",
                "media": "#/$defs/MediaEvidence",
                "transcript": "#/$defs/TranscriptEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MediaEvidence"
              },
              {
                "$ref": "#/$defs/TranscriptEvidence"
              },
              {
                "$ref": "#/$defs/AnswerAudioEvidence"
              },
              {
                "$ref": "#/$defs/AnswerTextEvidence"
              }
            ]
          },
          "type": "array"
        },
        "grounding": {
          "items": {
            "$ref": "#/$defs/Grounding"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/DraftProvenance"
        },
        "new_terms": {
          "items": {
            "$ref": "#/$defs/NewTerm"
          },
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "contract_version",
        "id",
        "case_id",
        "moment_id",
        "step_id",
        "language",
        "kind",
        "context",
        "situation_cue",
        "obstacle",
        "anticipation",
        "action",
        "alternatives",
        "reason",
        "immediate_result",
        "delayed_outcome",
        "evidence",
        "grounding",
        "provenance",
        "new_terms",
        "confidence"
      ],
      "title": "DecisionRecordDraft",
      "type": "object"
    },
    "DelayedOutcome": {
      "description": "The outcome known later (linked after the case).",
      "properties": {
        "status": {
          "$ref": "#/$defs/OutcomeStatus"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the outcome came from, e.g. a follow-up note."
        }
      },
      "required": [
        "status",
        "text",
        "source"
      ],
      "title": "DelayedOutcome",
      "type": "object"
    },
    "DraftAction": {
      "description": "The action in a draft. `text` is `null` when the surgeon didn't state it (D-054); `type`\nand `actor` are always set (`act` / `unknown` when not said).",
      "properties": {
        "type": {
          "$ref": "#/$defs/ActionType"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        }
      },
      "required": [
        "type",
        "text",
        "actor"
      ],
      "title": "DraftAction",
      "type": "object"
    },
    "DraftProvenance": {
      "description": "Provenance of a draft: nobody has confirmed it yet.",
      "properties": {
        "trust_label": {
          "$ref": "#/$defs/TrustLabel"
        },
        "attributed_to": {
          "$ref": "#/$defs/Role"
        },
        "generated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedBy"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` unless an AI model produced it."
        },
        "confirmed_by": {
          "type": "null"
        },
        "confirmed_at": {
          "type": "null"
        }
      },
      "required": [
        "trust_label",
        "attributed_to",
        "generated_by",
        "confirmed_by",
        "confirmed_at"
      ],
      "title": "DraftProvenance",
      "type": "object"
    },
    "DraftSituationCue": {
      "description": "The cue in a draft. `text` is `null` (and `cue_terms` empty) when the surgeon didn't state\nit; it is never filled from the moment (D-054).",
      "properties": {
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        },
        "cue_terms": {
          "description": "Short terms for retrieval, e.g. `venous oozing`, `静脈性出血`.",
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "text",
        "cue_terms"
      ],
      "title": "DraftSituationCue",
      "type": "object"
    },
    "GeneratedBy": {
      "description": "The model and prompt that produced an AI output.",
      "properties": {
        "model_tier": {
          "description": "The `.env` tier, e.g. `VISION_FAST` or `TEXT_SMART` (plan §3.1).",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "model": {
          "description": "The concrete model name the tier resolved to.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The prompt file and version, e.g. `step_window.v1`; `null` when no prompt was used."
        }
      },
      "required": [
        "model_tier",
        "model",
        "prompt_version"
      ],
      "title": "GeneratedBy",
      "type": "object"
    },
    "Grounding": {
      "description": "The words that support one filled field (G5).",
      "properties": {
        "field": {
          "description": "The whole field it supports, e.g. `reason` or `alternatives[0].why_not`: an existing,\nnon-null value; never one language of a Bilingual (`reason.en`), never an empty list (D-052).",
          "pattern": "^[a-z_][a-z0-9_]*(?:\\[[0-9]+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[[0-9]+\\])*)*$",
          "type": "string"
        },
        "quote": {
          "description": "Verbatim, in the original language (not translated).",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GroundingSource"
        }
      },
      "required": [
        "field",
        "quote",
        "source"
      ],
      "title": "Grounding",
      "type": "object"
    },
    "GroundingSource": {
      "description": "Where a grounding quote comes from (G5).",
      "enum": [
        "answer",
        "edit",
        "narration"
      ],
      "title": "GroundingSource",
      "type": "string"
    },
    "Lang": {
      "description": "A language the system works in.",
      "enum": [
        "ja",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    },
    "MediaEvidence": {
      "description": "A span of a case's video: `video.mp4` or a moment's clip. `t_start`/`t_end` are on the\nnormalised video's timeline, so a fragment on `video.mp4` must equal them (issue #9). A clip's\nfragment is relative to the clip and isn't compared.",
      "properties": {
        "t_start": {
          "description": "Seconds from the start of the normalised video.",
          "minimum": 0.0,
          "type": "number"
        },
        "t_end": {
          "description": "Seconds from the start of the normalised video; never before `t_start`.",
          "minimum": 0.0,
          "type": "number"
        },
        "kind": {
          "const": "media",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "uri": {
          "pattern": "^(video\\.mp4|clips/[a-z0-9]+(?:-[a-z0-9]+)*\\.m[0-9]{2,}\\.mp4)#t=([0-9]+(?:\\.[0-9]+)?),([0-9]+(?:\\.[0-9]+)?)$",
          "type": "string"
        }
      },
      "required": [
        "t_start",
        "t_end",
        "kind",
        "case_id",
        "uri"
      ],
      "title": "MediaEvidence",
      "type": "object"
    },
    "NewTerm": {
      "description": "A term the vocabulary doesn't know yet (G4).",
      "properties": {
        "term": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/Lang"
        }
      },
      "required": [
        "term",
        "lang"
      ],
      "title": "NewTerm",
      "type": "object"
    },
    "Obstacle": {
      "description": "The difficulty the decision dealt with, from the taxonomy in the Procedure Reference.",
      "properties": {
        "family": {
          "$ref": "#/$defs/ObstacleFamily"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^(?:bleeding|anatomical_variation|tissue_condition|visibility|technical_difficulty|equipment|patient_condition|unexpected_finding)\\.[a-z0-9]+(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A taxonomy leaf of the same family, e.g. `anatomical_variation.median_lobe`."
        },
        "cause": {
          "$ref": "#/$defs/ObstacleCause"
        }
      },
      "required": [
        "family",
        "type",
        "cause"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "ObstacleCause": {
      "description": "What the obstacle is attributed to.",
      "enum": [
        "patient",
        "event",
        "technical",
        "equipment",
        "unknown"
      ],
      "title": "ObstacleCause",
      "type": "string"
    },
    "ObstacleFamily": {
      "description": "The 8 fixed obstacle families of the taxonomy (D-035).",
      "enum": [
        "bleeding",
        "anatomical_variation",
        "tissue_condition",
        "visibility",
        "technical_difficulty",
        "equipment",
        "patient_condition",
        "unexpected_finding"
      ],
      "title": "ObstacleFamily",
      "type": "string"
    },
    "OutcomeStatus": {
      "description": "Whether the delayed outcome is known yet.",
      "enum": [
        "pending",
        "known",
        "not_applicable"
      ],
      "title": "OutcomeStatus",
      "type": "string"
    },
    "RecordContext": {
      "description": "What was known before the decision.",
      "properties": {
        "patient_factors": {
          "items": {
            "$ref": "#/$defs/Bilingual"
          },
          "type": "array"
        },
        "preop_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bilingual"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "patient_factors",
        "preop_plan"
      ],
      "title": "RecordContext",
      "type": "object"
    },
    "RecordKind": {
      "description": "What kind of decision the record captures. Deliberate non-action is `action.type`.",
      "enum": [
        "rescue",
        "anticipatory",
        "checkpoint",
        "bail_out"
      ],
      "title": "RecordKind",
      "type": "string"
    },
    "Role": {
      "description": "Who a piece of knowledge is attributed to.",
      "enum": [
        "ai",
        "dataset",
        "narrator",
        "operating_surgeon",
        "reviewer",
        "expert",
        "dev_team_simulated"
      ],
      "title": "Role",
      "type": "string"
    },
    "TranscriptEvidence": {
      "description": "A verbatim quote from a case's narration.",
      "properties": {
        "kind": {
          "const": "transcript",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "utterance_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.u[0-9]{4,}$",
          "type": "string"
        },
        "quote": {
          "description": "Verbatim, in the original language.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "case_id",
        "utterance_id",
        "quote"
      ],
      "title": "TranscriptEvidence",
      "type": "object"
    },
    "TrustLabel": {
      "description": "How far a piece of knowledge can be trusted. The emoji are for display only.",
      "enum": [
        "ai_detected",
        "dataset_annotation",
        "narration_extracted",
        "operating_surgeon",
        "reviewer",
        "expert_validated",
        "simulated"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "description": "The draft, plus what the answer app shows: read-back, chips and missing fields.",
  "properties": {
    "contract_version": {
      "description": "`\"MAJOR.MINOR\"`, currently `\"1.0\"`.",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/DecisionRecordDraft"
    },
    "readback": {
      "allOf": [
        {
          "$ref": "#/$defs/Bilingual"
        }
      ],
      "description": "What the app reads back to the surgeon before Confirm."
    },
    "chips": {
      "items": {
        "$ref": "#/$defs/Chip"
      },
      "type": "array"
    },
    "missing_fields": {
      "description": "Draft fields the surgeon did not state (each `null` or an empty list), for follow-up.",
      "items": {
        "pattern": "^[a-z_][a-z0-9_]*(?:\\[[0-9]+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[[0-9]+\\])*)*$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "draft",
    "readback",
    "chips",
    "missing_fields"
  ],
  "title": "ExtractResponse",
  "type": "object"
}
