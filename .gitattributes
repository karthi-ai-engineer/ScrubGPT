# Normalise line endings across all Windows machines: Dev1 (x64 office PC, ARM64 Surface), Dev2 (ARM64 Zenbook, x64 office laptop #2)
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.webm binary
*.wav  binary
*.mp3  binary
*.pdf  binary
